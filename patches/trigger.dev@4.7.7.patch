+// Bounded public child-side evidence. IPC return is not a receiver acknowledgement.
+// Diagnostic faults must never change the existing completion protocol or lifecycle.
+const quiet = (fn) => { try { return fn(); } catch {} };
+// A parent FLUSH carries no run, attempt or origin and also follows suspension, so this
+// receipt proves only command entry in the current child context, never a completion ACK.
+// It retains bounded primitives and the parent context captured at probe creation only.
+function createParentFlushReceipt(tracer, parent, resultOk, attempt) {
+    let phase = "packet_pending";
+    let pending = true;
+    return {
+        advance(next) { phase = next; },
+        failed() { phase = phase === "packet_pending" ? "packet_error" : "invocation_error"; },
+        received(live) {
+            if (!pending) return;
+            // Consume before optional tracer work: repeated or concurrent FLUSH emits at most once.
+            pending = false;
+            quiet(() => {
+                const attributes = {
+                    "hackerai.child_completion.version": 1,
+                    "hackerai.child_completion.association": "current_child_context",
+                    "hackerai.child_completion.phase": phase,
+                    "hackerai.child_completion.disable_context": live.disableContext === true,
+                    "hackerai.child_completion.worker_running": live.isRunning === true,
+                    "hackerai.child_completion.worker_cancelled": live.isCancelled === true,
+                    "hackerai.child_completion.process_connected": live.connected === true,
+                    "hackerai.child_completion.result_ok": resultOk,
+                };
+                if (attempt !== undefined) attributes["hackerai.child_completion.attempt"] = attempt;
+                tracer.startSpan("parent flush request received", { attributes }, parent).end();
+            });
+        },
+    };
+}
+export function createChildCompletionProbe({ tracer, getParentContext, execution, result, isRunning, isCancelled, connected }) {
+    let packetSpan;
+    let ipcSpan;
+    const finish = (span, outcome) => {
+        quiet(() => span?.setAttribute("hackerai.child_completion.outcome", outcome));
+        quiet(() => span?.end());
+    };
+    const inert = { packetReady: (packet) => packet, observeReturn() {}, skipped() {}, failed() {} };
+    return quiet(() => {
+        if (execution.task.id !== "agent-long") return inert;
+        const parent = getParentContext();
+        const attributes = {
+            "hackerai.child_completion.version": 1,
+            "hackerai.child_completion.worker_running": isRunning === true,
+            "hackerai.child_completion.worker_cancelled": isCancelled === true,
+            "hackerai.child_completion.process_connected": connected === true,
+            "hackerai.child_completion.result_ok": result.ok === true,
+        };
+        const attempt = execution.attempt.number;
+        if (Number.isSafeInteger(attempt) && attempt >= 1 && attempt <= 1000000) {
+            attributes["hackerai.child_completion.attempt"] = attempt;
+        }
+        const parentFlush = createParentFlushReceipt(tracer, parent,
+            attributes["hackerai.child_completion.result_ok"], attributes["hackerai.child_completion.attempt"]);
+        const start = (name) => quiet(() => tracer.startSpan(name, { attributes }, parent));
+        packetSpan = start("child completion packet");
+        return {
+            parentFlush,
+            packetReady(packet) {
+                parentFlush.advance("packet_ready");
+                finish(packetSpan, "packet_ready");
+                packetSpan = undefined;
+                ipcSpan = start("child completion IPC");
+                return packet;
+            },
+            observeReturn(promise) {
+                const span = ipcSpan;
+                // Observe the original Promise without returning a replacement or awaiting it.
+                // ZodIpcConnection may silently drop a disconnected send; fulfillment is not ACK.
+                quiet(() => Promise.prototype.then.call(promise,
+                    () => { parentFlush.advance("returned_unacknowledged"); finish(span, "returned_unacknowledged"); },
+                    () => { parentFlush.advance("rejected"); finish(span, "rejected"); }));
+                ipcSpan = undefined;
+            },
+            skipped(isRunningNow, isCancelledNow) {
+                const outcome = isCancelledNow === true ? "cancelled_guard" : "not_running_guard";
+                parentFlush.advance(outcome);
+                quiet(() => packetSpan?.setAttribute("hackerai.child_completion.worker_running", isRunningNow === true));
+                quiet(() => packetSpan?.setAttribute("hackerai.child_completion.worker_cancelled", isCancelledNow === true));
+                finish(packetSpan, outcome);
+                packetSpan = undefined;
+            },
+            failed() {
+                parentFlush.failed();
+                finish(packetSpan, "packet_error");
+                finish(ipcSpan, "invocation_error");
+                packetSpan = undefined;
+                ipcSpan = undefined;
+            },
+        };
+    }) ?? inert;
+}
