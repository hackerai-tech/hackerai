@@ -0,0 +1,56 @@
+// Bounded public child-side evidence. IPC return is not a receiver acknowledgement.
+// Diagnostic faults must never change the existing completion protocol or lifecycle.
+export function createChildCompletionProbe({ tracer, getParentContext, execution, result, isRunning, isCancelled, connected }) {
+    let packetSpan;
+    let ipcSpan;
+    const quiet = (fn) => { try { return fn(); } catch {} };
+    const finish = (span, outcome) => {
+        quiet(() => span?.setAttribute("hackerai.child_completion.outcome", outcome));
+        quiet(() => span?.end());
+    };
+    const inert = { packetReady: (packet) => packet, observeReturn() {}, skipped() {}, failed() {} };
+    return quiet(() => {
+        if (execution.task.id !== "agent-long") return inert;
+        const parent = getParentContext();
+        const attributes = {
+            "hackerai.child_completion.version": 1,
+            "hackerai.child_completion.worker_running": isRunning === true,
+            "hackerai.child_completion.worker_cancelled": isCancelled === true,
+            "hackerai.child_completion.process_connected": connected === true,
+            "hackerai.child_completion.result_ok": result.ok === true,
+        };
+        const attempt = execution.attempt.number;
+        if (Number.isSafeInteger(attempt) && attempt >= 1 && attempt <= 1000000) {
+            attributes["hackerai.child_completion.attempt"] = attempt;
+        }
+        const start = (name) => quiet(() => tracer.startSpan(name, { attributes }, parent));
+        packetSpan = start("child completion packet");
+        return {
+            packetReady(packet) {
+                finish(packetSpan, "packet_ready");
+                packetSpan = undefined;
+                ipcSpan = start("child completion IPC");
+                return packet;
+            },
+            observeReturn(promise) {
+                const span = ipcSpan;
+                // Observe the original Promise without returning a replacement or awaiting it.
+                // ZodIpcConnection may silently drop a disconnected send; fulfillment is not ACK.
+                quiet(() => Promise.prototype.then.call(promise,
+                    () => finish(span, "returned_unacknowledged"),
+                    () => finish(span, "rejected")));
+                ipcSpan = undefined;
+            },
+            skipped() {
+                finish(packetSpan, isCancelled === true ? "cancelled_guard" : "not_running_guard");
+                packetSpan = undefined;
+            },
+            failed() {
+                finish(packetSpan, "packet_error");
+                finish(ipcSpan, "invocation_error");
+                packetSpan = undefined;
+                ipcSpan = undefined;
+            },
+        };
+    }) ?? inert;
+}
