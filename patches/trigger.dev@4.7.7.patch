diff --git a/dist/esm/entryPoints/s2-uncaught-diagnostic.js b/dist/esm/entryPoints/s2-uncaught-diagnostic.js
new file mode 100644
index 0000000000000000000000000000000000000000..6a5e032d993ef9cd3718c96e1654956a90c92d4f
--- /dev/null
+++ b/dist/esm/entryPoints/s2-uncaught-diagnostic.js
@@ -0,0 +1,127 @@
+// HackerAI S2 global-uncaught diagnostic on the existing UNCAUGHT_EXCEPTION error.stack string.
+// It decorates only a copy of the worker's already-read { name, message, stack }; the original
+// Error, console output, IPC keys, terminal code/message, propagation and process lifetime are
+// unchanged, and any diagnostic fault returns the original serialized payload.
+/**
+ * Fixed versioned NONFRAME marker. An annotated stack is the complete original stack, "\n",
+ * this marker, one space and compact closed-schema JSON as its last line. Plain stack text
+ * cannot authenticate its writer: diagnostic context only, never authorization, provider
+ * truth or proof of the physical cause.
+ */
+export const S2_UNCAUGHT_MARKER = "[hackerai.s2_uncaught.v1]";
+const MARKER_TOKEN = "hackerai.s2_uncaught";
+const S2_FRAME = "@s2-dev/streamstore";
+// Core sanitizeError/truncateStack caps lines at 1024 characters and keeps 50 lines from the
+// first frame. Skip rather than clip so every original byte and the trailer survive it.
+const MAX_STACK_BYTES = 16 * 1024;
+const MAX_LINE_CHARS = 1024;
+const MAX_FRAME_LINES = 50;
+const MAX_TRAILER_BYTES = 1024;
+const MAX_ATTEMPTS = /^Max attempts \(\d{1,7}\) exhausted: /;
+// Literal codes in @s2-dev/streamstore 0.25 sources, including the Node/undici connection codes
+// it classifies. Any other value, including arbitrary server codes, becomes other_or_absent.
+const CODES = new Set([
+    "ECONNREFUSED", "ENOTFOUND", "ETIMEDOUT", "ENETUNREACH", "EHOSTUNREACH", "ECONNRESET", "EPIPE",
+    "UND_ERR_SOCKET", "UND_ERR_CONNECT_TIMEOUT", "UND_ERR_HEADERS_TIMEOUT", "UND_ERR_BODY_TIMEOUT",
+    "NETWORK_ERROR", "connection_failed", "REQUEST_TIMEOUT", "TIMEOUT", "CONNECTION_TIMEOUT",
+    "STREAM_CLOSED_PREMATURELY", "BAD_GATEWAY", "SESSION_CLOSED", "INVALID_RESPONSE",
+    "INVALID_ARGUMENT", "UNSAFE_INTEGER", "APPEND_CONDITION_FAILED", "INTERNAL_ERROR",
+    "INTERNAL_SDK_ERROR", "ABORTED", "rate_limited", "hot_server",
+]);
+const PROPERTY_ORIGINS = new Set(["server", "sdk"]);
+const NODE_ORIGINS = new Set(["uncaughtException", "unhandledRejection"]);
+const inert = Object.freeze({ completionBoundary() { }, consume() { return undefined; } });
+// Own DATA descriptor only: never runs getters, reads inherited values or coerces. A Proxy
+// descriptor trap may throw; annotateS2Uncaught then returns the original payload.
+function ownData(error, key) {
+    const descriptor = Object.getOwnPropertyDescriptor(error, key);
+    return descriptor !== undefined && "value" in descriptor ? descriptor.value : undefined;
+}
+// Eligibility reads only the handler's already-read values, never the Error again.
+function eligible({ name, message, stack }) {
+    if (name !== "S2Error" || typeof message !== "string" || typeof stack !== "string") return false;
+    if (stack.includes("\0") || stack.includes(MARKER_TOKEN) || message.includes(MARKER_TOKEN)) return false;
+    if (Buffer.byteLength(stack, "utf8") > MAX_STACK_BYTES) return false;
+    let frameLines = 0;
+    let s2Frame = false;
+    for (const line of stack.split("\n")) {
+        if (line.length > MAX_LINE_CHARS) return false;
+        const frame = line.trimStart().startsWith("at ");
+        if (frame || frameLines > 0) frameLines++;
+        if (frame && line.includes(S2_FRAME)) s2Frame = true;
+    }
+    // The appended line is one more line after the first frame.
+    return s2Frame && frameLines < MAX_FRAME_LINES;
+}
+/**
+ * Create one EXECUTE's one-shot S2 uncaught diagnostic. Register it in the worker slot after
+ * bootstrap, immediately before executor.execute, and clear that slot at every EXECUTE and
+ * reset. Non-Agent executions and creation faults return an inert probe. `live()` returns the
+ * worker's current { execution, isRunning, isCancelled, contextEnabled, connected } and runs
+ * only after the latch is consumed. Phase is execution_active, completion_boundary (executor
+ * returned, cleanup pending) or other; no provider stage is inferred.
+ * association=current_child_context names the child context current when the handler ran;
+ * it does not establish which execution originated a latent error.
+ */
+export function createS2UncaughtProbe({ execution, live }) {
+    try {
+        if (execution.task.id !== "agent-long") return inert;
+        const number = execution.attempt.number;
+        const attempt = Number.isSafeInteger(number) && number >= 1 && number <= 1000000 ? number : undefined;
+        let boundary = false;
+        let pending = true;
+        return {
+            completionBoundary() { boundary = true; },
+            consume(serialized, error, origin) {
+                if (!pending) return undefined;
+                // Consume before introspection: repeated or reentrant events add nothing.
+                pending = false;
+                const state = live();
+                if (state.execution !== execution || state.contextEnabled !== true || !eligible(serialized)) return undefined;
+                const fields = {
+                    version: 1,
+                    association: "current_child_context",
+                    phase: boundary ? "completion_boundary" : state.isRunning === true ? "execution_active" : "other",
+                    node_origin: NODE_ORIGINS.has(origin) ? origin : "other_or_absent",
+                };
+                const status = ownData(error, "status");
+                if (Number.isInteger(status) && (status === 0 || (status >= 100 && status <= 599))) fields.status = status;
+                const code = ownData(error, "code");
+                fields.code = CODES.has(code) ? code : "other_or_absent";
+                const propertyOrigin = ownData(error, "origin");
+                fields.property_origin = PROPERTY_ORIGINS.has(propertyOrigin) ? propertyOrigin : "other_or_absent";
+                fields.max_attempt_exhausted = MAX_ATTEMPTS.test(serialized.message);
+                fields.worker_running = state.isRunning === true;
+                fields.worker_cancelled = state.isCancelled === true;
+                fields.process_connected = state.connected === true;
+                if (attempt !== undefined) fields.attempt = attempt;
+                const trailer = `\n${S2_UNCAUGHT_MARKER} ${JSON.stringify(fields)}`;
+                return Buffer.byteLength(trailer, "utf8") <= MAX_TRAILER_BYTES ? trailer : undefined;
+            },
+        };
+    }
+    catch {
+        return inert;
+    }
+}
+/**
+ * Return the handler's already-read { name, message, stack } exactly or, for the first
+ * uncaught event of a current context-enabled Agent execution whose snapshot is an S2Error
+ * with an @s2-dev/streamstore frame within sanitizer bounds (no NUL or existing marker,
+ * <=16KiB UTF-8, lines <=1024 characters, <50 lines from the first frame), a copy whose
+ * stack appends one marker line of <=1024 bytes. Never re-reads error name/message/stack or
+ * mutates the error; status/code/origin come only from own data descriptors. Fields: status
+ * integer 0 or 100..599 (else omitted); code and property_origin closed sets (else
+ * other_or_absent); node_origin from the handler argument; strict booleans; attempt
+ * 1..1000000 (else omitted). S2's max-attempt wrapper copies status/code but not origin, so
+ * property_origin "sdk" there is the constructor default, not proof of a local cause.
+ */
+export function annotateS2Uncaught(probe, serialized, error, origin) {
+    try {
+        const trailer = probe?.consume(serialized, error, origin);
+        return typeof trailer === "string" ? { ...serialized, stack: serialized.stack + trailer } : serialized;
+    }
+    catch {
+        return serialized;
+    }
+}
